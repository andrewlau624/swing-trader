# Weekdays 09:35 ET: after the 09:30 opening-cross prints exist (night buys from the prior
# session are the overnight names; the module skips non-sessions and pre-2026-12-06 dates).
[Unit]
Description=swing-trader OVN-23/5 recorder schedule

[Timer]
OnCalendar=Mon..Fri *-*-* 09:35:00 America/New_York
Persistent=false
Unit=ovn-235-recorder.service

[Install]
WantedBy=timers.target
