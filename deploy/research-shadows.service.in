# Installed by `make persist`. Round 31 forward logs, no orders: the insider-purchase session shadow (ID3) and the
# odd-lot tender watch (emails a qualifying offer) and, Round 32, the split-off
# exchange-offer watch; index-beat FOUND: the stacked-book shadow (stack_shadow, logs only). Reads EDGAR at SEC's rate limit (~6-8 min).
[Unit]
Description=swing-trader research shadows (stack shadow, ex-date open, PREF-EX, CEF-RV, repeat-loser, crowded-night hold, TOP2, capacity shadow, leap SOXL IBS, pick cost, insider-day, tender watch, split-off watch, round-up watch, CEF activist watch, CPC forward ledger, forced-flow EDGAR discovery)

[Service]
Type=oneshot
WorkingDirectory=__APP_DIR__
EnvironmentFile=-__APP_DIR__/.env
Environment=PYTHONPATH=__APP_DIR__
ExecStart=-__APP_DIR__/.venv/bin/python -u -m swingtrader.daily.stack_shadow
ExecStart=-__APP_DIR__/.venv/bin/python -u -m swingtrader.daily.pick_cost_watch
ExecStart=-__APP_DIR__/.venv/bin/python -u -m swingtrader.daily.exdate_open_shadow
ExecStart=-__APP_DIR__/.venv/bin/python -u -m swingtrader.daily.pref_ex_shadow
ExecStart=-__APP_DIR__/.venv/bin/python -u -m swingtrader.daily.cef_rv_shadow
ExecStart=-__APP_DIR__/.venv/bin/python -u -m swingtrader.daily.repeat_shadow
ExecStart=-__APP_DIR__/.venv/bin/python -u -m swingtrader.daily.crowd_hold_shadow
ExecStart=-__APP_DIR__/.venv/bin/python -u -m swingtrader.daily.top2_shadow
ExecStart=-__APP_DIR__/.venv/bin/python -u -m swingtrader.daily.insider_shadow
ExecStart=-__APP_DIR__/.venv/bin/python -u -m swingtrader.daily.tender_watch
ExecStart=-__APP_DIR__/.venv/bin/python -u -m swingtrader.daily.splitoff_watch
ExecStart=-__APP_DIR__/.venv/bin/python -u -m swingtrader.daily.roundup_watch
ExecStart=-__APP_DIR__/.venv/bin/python -u -m swingtrader.daily.cef_activist_watch
ExecStart=-__APP_DIR__/.venv/bin/python -u -m swingtrader.daily.cpc_ledger
ExecStart=-__APP_DIR__/.venv/bin/python -u -m swingtrader.daily.forced_flow_discovery
ExecStart=-__APP_DIR__/.venv/bin/python -u -m swingtrader.daily.ibs_lev_shadow
ExecStart=-__APP_DIR__/.venv/bin/python -u -m swingtrader.daily.size_shadow
ExecStart=-__APP_DIR__/.venv/bin/python -u -m swingtrader.leap.shadow
ExecStart=-__APP_DIR__/.venv/bin/python -u -m research.sim.tme_shadow forward
ExecStart=-__APP_DIR__/.venv/bin/python -u -m swingtrader.daybook.shadow forward
TimeoutStartSec=1800
