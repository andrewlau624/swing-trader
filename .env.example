ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Email alerts on every order/fill (Resend - https://resend.com/api-keys)
RESEND_API_KEY=
NOTIFY_EMAIL=you@example.com
# Must be a Resend-verified domain. onboarding@resend.dev works without one,
# but only delivers to the address that owns the Resend account.
NOTIFY_FROM=onboarding@resend.dev

# REAL-MONEY account for the daily book (optional). Only used once you run
# `make daily-live-on`. Live keys start with AK; paper keys start with PK.
ALPACA_LIVE_API_KEY=
ALPACA_LIVE_SECRET_KEY=
# Real money on/off for the daily book. Set by `make daily-live-on/off`.
DAILY_LIVE=off

# SCHWAB (real money). developer.schwab.com -> Dashboard -> your app.
# Then run `make schwab-login` (repeat every 7 days).
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
SCHWAB_CALLBACK_URL=https://127.0.0.1
# only needed if more than one Schwab account is linked:
SCHWAB_ACCOUNT_NUMBER=
# Optional hard cap on real-money capital (dollars). Lives here, not in
# config.yaml, because `make pull` resets tracked files.
DAILY_LIVE_CAPITAL=
# Swing book (paper only). Quarantined: behind SPY at its live cadence
# (RESULTS.md addendum 14). `make persist` schedules it only when this is on.
SWING_BOOK=off
