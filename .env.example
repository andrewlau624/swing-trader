ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Email alerts on every order/fill (Resend - https://resend.com/api-keys)
RESEND_API_KEY=
NOTIFY_EMAIL=you@example.com
# Must be a Resend-verified domain. onboarding@resend.dev works without one,
# but only delivers to the address that owns the Resend account.
NOTIFY_FROM=onboarding@resend.dev
